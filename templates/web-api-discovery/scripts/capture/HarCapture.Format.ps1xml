<?xml version="1.0" encoding="utf-8"?>
<!--
    Console rendering for capture catalogue entries.

    The catalogue is emitted as objects, never as text, so the pipeline stays
    pure data and ConvertTo-Json / ConvertTo-Csv work on the same result. What
    a human sees at the console is PowerShell's own formatting engine applied
    to those objects, which is why this file exists instead of a Write-Host
    table hand-rolled in the script.

    Endpoints and Methods are joined for display only. The underlying
    properties stay arrays.
-->
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>IntelliSDLC.HarCapture.CatalogueEntry</Name>
      <ViewSelectedBy>
        <TypeName>IntelliSDLC.HarCapture.CatalogueEntry</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>Status</Label>
            <Width>10</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Action</Label>
            <Width>32</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Methods</Label>
            <Width>12</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Entries</Label>
            <Alignment>Right</Alignment>
            <Width>7</Width>
          </TableColumnHeader>
          <!--
              Request bodies sits beside the entry count on purpose. It is the
              column that makes a hollow reference visible at a glance: a row
              describing what a client SENT, against a file whose entries carry
              no request body, reads as `1  0` instead of looking like every
              other row. Four such references shipped because nothing put that
              number in front of a human (issue #379).
          -->
          <TableColumnHeader>
            <Label>ReqBodies</Label>
            <Alignment>Right</Alignment>
            <Width>9</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Endpoints</Label>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <PropertyName>Status</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Action</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>$_.Methods -join ','</ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>EntryCount</PropertyName>
              </TableColumnItem>
              <!--
                  A dash for null, never 0. A scaffold row has measured nothing
                  yet, and rendering that as `0` would say "this reference has
                  no request bodies" about a reference that does not exist.
                  (A literal double hyphen cannot appear in an XML comment, so
                  the placeholder is described rather than written here.)
              -->
              <TableColumnItem>
                <ScriptBlock>if ($null -eq $_.RequestBodies) { '--' } else { $_.RequestBodies }</ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>$_.Endpoints -join ', '</ScriptBlock>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>IntelliSDLC.HarCapture.CatalogueEntry.List</Name>
      <ViewSelectedBy>
        <TypeName>IntelliSDLC.HarCapture.CatalogueEntry</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem>
                <PropertyName>Action</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>Description</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>Status</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>Methods</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>Endpoints</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>EntryCount</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>RequestBodies</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>RequestBytes</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>ResponseBytes</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>RequestBodiesAbsent</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>Provider</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>HarFile</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>Related</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>CapturedUtc</PropertyName>
              </ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
  </ViewDefinitions>
</Configuration>
