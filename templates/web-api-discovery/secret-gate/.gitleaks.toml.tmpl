# gitleaks configuration for wrapper projects emitted by web-api-discovery.
# Defense in depth: this same ruleset runs in the pre-commit hook AND the CI
# secret-scan workflow.
#
# Inherits the gitleaks built-in ruleset and adds tuned rules for common
# wrapper-project leak shapes (bearer tokens, JWTs, long hex secrets,
# api_key= shapes). Allowlist entries are intentionally narrow.

title = "wrapper-project-gitleaks"

[extend]
useDefault = true

[[rules]]
id = "wrapper-bearer-token"
description = "Authorization: Bearer <token> header value"
regex = '''(?i)authorization:\s*bearer\s+[A-Za-z0-9._\-+/=]{20,}'''
tags = ["auth", "bearer"]

[[rules]]
id = "wrapper-jwt"
description = "JSON Web Token (3 dot-separated base64url segments)"
regex = '''eyJ[A-Za-z0-9_\-]{10,}\.[A-Za-z0-9_\-]{10,}\.[A-Za-z0-9_\-]{10,}'''
tags = ["auth", "jwt"]

[[rules]]
id = "wrapper-long-hex"
description = "Long hex string (>=32 chars) -- API secret / hash material"
regex = '''(?i)(?:secret|token|key|sig|signature)["'\s:=]+([a-f0-9]{32,})'''
tags = ["secret", "hex"]

[[rules]]
id = "wrapper-api-key-assignment"
description = "api_key= / api-key= / apikey= assignment"
regex = '''(?i)api[_-]?key["'\s:=]+[A-Za-z0-9._\-]{16,}'''
tags = ["secret", "api-key"]

# ---------------------------------------------------------------------------
# Allowlist (narrow). Do NOT broaden to **/*.json -- that would defeat the gate.
# ---------------------------------------------------------------------------

[allowlist]
description = "Deterministic test fixtures and PR #47 PII-fake markers."
paths = [
    '''Samples/HAR-Scrubbed/\.substitutions\.json$''',
    '''tests/fixtures/.*\.json$''',
    '''tests/.*/Properties/launchSettings\.json$''',
]
regexes = [
    # PR #47 deterministic fake-marker values. Never real secrets.
    '''@example\.invalid''',
    '''\b4242[0-9]{12}\b''',
    '''\b9XX-XX-[0-9]{4}\b''',
    '''192\.0\.2\.[0-9]{1,3}''',
]