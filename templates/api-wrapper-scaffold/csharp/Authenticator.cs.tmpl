using Microsoft.Extensions.Logging;
using Microsoft.Extensions.Logging.Abstractions;
using Microsoft.Playwright;

namespace {{Namespace}}.Auth;

/// <summary>
/// Acquires a {{ProjectName}} session against <c>{{BaseUrl}}</c> by
/// launching a real Chromium browser via <see cref="Microsoft.Playwright"/>,
/// letting the user authenticate interactively (any SSO, any 2FA, any
/// captcha -- it's a real browser), and then capturing the resulting
/// session cookies from the live browser context.
///
/// The wrapper never sees the user's credentials; it only receives the
/// post-authentication cookies and storage state from Playwright.
///
/// Use <see cref="BrowserLoginAsync"/> to run the ceremony. The returned
/// <see cref="SessionCredentials"/> can be persisted via the existing
/// <c>ISessionStore</c>.
/// </summary>
public sealed class {{ProjectName}}Authenticator
{
    private const string BaseUrl = "{{BaseUrl}}";
    private readonly ILogger<{{ProjectName}}Authenticator> _log;
    private readonly Func<Task<IPlaywright>> _playwrightFactory;
    private readonly Action<string> _writeLine;
    private readonly Func<string> _readLine;

    /// <summary>
    /// Creates a new authenticator wired to the real Playwright runtime
    /// and the process console.
    /// </summary>
    public {{ProjectName}}Authenticator(ILogger<{{ProjectName}}Authenticator>? log = null)
        : this(log, playwrightFactory: null, writeLine: null, readLine: null)
    {
    }

    /// <summary>
    /// Test-friendly constructor. Allows the unit tests to swap in a fake
    /// <see cref="IPlaywright"/> and capture console output without
    /// spinning up a real browser.
    /// </summary>
    public {{ProjectName}}Authenticator(
        ILogger<{{ProjectName}}Authenticator>? log,
        Func<Task<IPlaywright>>? playwrightFactory,
        Action<string>? writeLine,
        Func<string>? readLine)
    {
        _log = log ?? NullLogger<{{ProjectName}}Authenticator>.Instance;
        _playwrightFactory = playwrightFactory ?? Playwright.CreateAsync;
        _writeLine = writeLine ?? Console.Out.WriteLine;
        _readLine = readLine ?? (() => Console.In.ReadLine() ?? string.Empty);
    }

    /// <summary>
    /// Builds the Chromium launch options used by <see cref="BrowserLoginAsync"/>.
    /// <para>
    /// <c>Channel = "chrome"</c> reuses the user's installed system Chrome
    /// instead of Playwright's bundled Chromium build. This avoids the
    /// ~150 MB Chromium download (which is not present unless the user
    /// has run <c>playwright.ps1 install</c>) and gives the user a
    /// familiar browser for the sign-in ceremony.
    /// </para>
    /// </summary>
    internal static BrowserTypeLaunchOptions BuildLaunchOptions() =>
        new()
        {
            Headless = false,
            Channel = "chrome",
        };

    /// <summary>
    /// Launches Chromium, navigates to <c>{{BaseUrl}}</c>, prompts the user to
    /// complete the {{IdpName}} sign-in flow in the visible browser window,
    /// and captures the resulting cookies + storage state once the user
    /// signals completion (Enter on the console).
    ///
    /// Returns the captured <see cref="SessionCredentials"/>. Callers should
    /// persist via the project's <c>ISessionStore</c>.
    /// </summary>
    /// <param name="ct">Cancellation token. Cancelling closes the browser
    /// and propagates <see cref="OperationCanceledException"/>.</param>
    public async Task<SessionCredentials> BrowserLoginAsync(CancellationToken ct = default)
    {
        _log.LogInformation("Launching Playwright Chromium for interactive sign-in to {BaseUrl}", BaseUrl);

        using var playwright = await _playwrightFactory().ConfigureAwait(false);
        await using var browser = await playwright.Chromium.LaunchAsync(BuildLaunchOptions()).ConfigureAwait(false);
        await using var context = await browser.NewContextAsync().ConfigureAwait(false);
        var page = await context.NewPageAsync().ConfigureAwait(false);

        try
        {
            await page.GotoAsync(BaseUrl).ConfigureAwait(false);

            _writeLine("");
            _writeLine($"  A browser window has opened to {BaseUrl}.");
            _writeLine($"  Please complete the {{IdpName}} sign-in flow there.");
            _writeLine("  When you reach the authenticated landing page, return here");
            _writeLine("  and press <Enter> to capture the session cookies.");
            _writeLine("");

            await Task.Run(() => _readLine(), ct).ConfigureAwait(false);

            return await CaptureSessionAsync(context, page, ct).ConfigureAwait(false);
        }
        finally
        {
            await page.CloseAsync().ConfigureAwait(false);
        }
    }

    /// <summary>
    /// Extracts the cookie header and best-effort CSRF token from the
    /// live browser context after the user has completed sign-in.
    /// Exposed internally so unit tests can drive the extraction step
    /// without launching a real Chromium.
    /// </summary>
    internal async Task<SessionCredentials> CaptureSessionAsync(
        IBrowserContext context,
        IPage page,
        CancellationToken ct = default)
    {
        ct.ThrowIfCancellationRequested();

        var baseUri = new Uri(BaseUrl);
        var cookies = await context.CookiesAsync(new[] { BaseUrl }).ConfigureAwait(false);
        var cookieHeader = string.Join("; ", cookies
            .Where(c => c.Domain.EndsWith(baseUri.Host, StringComparison.OrdinalIgnoreCase)
                        || baseUri.Host.EndsWith(c.Domain.TrimStart('.'), StringComparison.OrdinalIgnoreCase))
            .Select(c => $"{c.Name}={c.Value}"));

        if (string.IsNullOrEmpty(cookieHeader))
        {
            throw new InvalidOperationException(
                "{{ProjectName}}Authenticator: no cookies were captured from the browser. " +
                "Did you complete the {{IdpName}} sign-in before pressing <Enter>?");
        }

        var csrfToken = await TryReadCsrfTokenAsync(page).ConfigureAwait(false);
        _log.LogInformation("Captured {Count} cookies from {BaseUrl} (csrf {CsrfState})",
            cookies.Count, BaseUrl, string.IsNullOrEmpty(csrfToken) ? "absent" : "present");

        return new SessionCredentials(cookieHeader, csrfToken ?? string.Empty);
    }

    private static async Task<string?> TryReadCsrfTokenAsync(IPage page)
    {
        try
        {
            return await page.EvaluateAsync<string?>(
                "() => document.querySelector('meta[name=\"csrf-token\"]')?.content " +
                "|| window.__CSRF_TOKEN__ || null").ConfigureAwait(false);
        }
        catch (PlaywrightException)
        {
            return null;
        }
    }
}
