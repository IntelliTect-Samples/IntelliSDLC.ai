using System.Net;
using System.Net.Http.Headers;
using System.Text;
using System.Text.Json;
using Microsoft.Extensions.Logging;
using Microsoft.Extensions.Logging.Abstractions;
using {{Namespace}}.Auth;

namespace {{Namespace}};

/// <summary>
/// HTTP client for the {{ProjectName}} target API ({{BaseUrl}}).
/// Auth state is provided by an <see cref="ISessionStore"/>; the client replays
/// the captured session (typically a Cookie header, optionally with a CSRF token)
/// on every request. Endpoint methods are added as partial classes in
/// {{ProjectName}}Client.g.cs (generated by the api-wrapper-scaffold agent).
/// </summary>
public sealed partial class {{ProjectName}}Client : IDisposable
{
    private const string BaseUrl = "{{BaseUrl}}";
    private const string UserAgent =
        "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 " +
        "(KHTML, like Gecko) Chrome/147.0.0.0 Safari/537.36";

    private static readonly JsonSerializerOptions s_jsonOptions = new()
    {
        PropertyNameCaseInsensitive = true,
    };

    private readonly HttpClient _http;
    private readonly bool _ownsHttpClient;
    private readonly SessionCredentials _session;
    private readonly ILogger<{{ProjectName}}Client> _log;

    public {{ProjectName}}Client(SessionCredentials session, ILogger<{{ProjectName}}Client>? log = null)
    {
        _session = session ?? throw new ArgumentNullException(nameof(session));
        _log = log ?? NullLogger<{{ProjectName}}Client>.Instance;
        var handler = new HttpClientHandler
        {
            UseCookies = false,
            AutomaticDecompression = DecompressionMethods.All,
            AllowAutoRedirect = false,
        };
        _http = new HttpClient(handler) { Timeout = TimeSpan.FromSeconds(60) };
        _ownsHttpClient = true;
    }

    /// <summary>
    /// Test / DI overload that accepts an externally owned <see cref="HttpClient"/>.
    /// </summary>
    public {{ProjectName}}Client(SessionCredentials session, HttpClient httpClient, ILogger<{{ProjectName}}Client>? log = null)
    {
        _session = session ?? throw new ArgumentNullException(nameof(session));
        _http = httpClient ?? throw new ArgumentNullException(nameof(httpClient));
        _ownsHttpClient = false;
        _log = log ?? NullLogger<{{ProjectName}}Client>.Instance;
    }

    public bool IsConfigured => !string.IsNullOrEmpty(_session.Cookie);

    /// <summary>
    /// Issues an authenticated HTTP request (verb supplied by the caller) against
    /// an arbitrary path under <c>{{BaseUrl}}</c> and returns the raw response body.
    /// Public escape hatch for endpoints that do not yet have a typed wrapper.
    /// </summary>
    /// <param name="path">URL path (with leading slash) relative to <c>{{BaseUrl}}</c>.</param>
    /// <param name="method">HTTP method to use. Defaults to GET when null.</param>
    /// <param name="jsonBody">Optional JSON request body. When supplied, sent as
    /// <c>application/json</c>; the HTTP method should typically be POST/PUT/PATCH.</param>
    /// <param name="query">Optional query-string key/value pairs.</param>
    /// <param name="ct">Cancellation token.</param>
    public async Task<string> SendRawAsync(
        string path,
        HttpMethod? method = null,
        string? jsonBody = null,
        IEnumerable<KeyValuePair<string, string?>>? query = null,
        CancellationToken ct = default)
    {
        if (!IsConfigured)
        {
            throw new InvalidOperationException(
                "{{ProjectName}} session is not configured. Run the {{ProjectName}} authenticator " +
                "or populate the configured ISessionStore.");
        }

        method ??= HttpMethod.Get;
        var qs = BuildQuery(query);
        var url = BaseUrl + path + qs;

        using var req = new HttpRequestMessage(method, url);
        req.Headers.UserAgent.ParseAdd(UserAgent);
        req.Headers.Accept.Add(new MediaTypeWithQualityHeaderValue("application/json"));
        req.Headers.AcceptEncoding.ParseAdd("gzip, deflate, br");
        req.Headers.AcceptLanguage.ParseAdd("en-US,en;q=0.9");
        req.Headers.Add("Origin", BaseUrl);
        req.Headers.Add("X-Requested-With", "XMLHttpRequest");
        if (!string.IsNullOrEmpty(_session.CsrfToken))
        {
            req.Headers.Add("X-CSRF-Token", _session.CsrfToken);
        }
        req.Headers.Add("Cookie", _session.Cookie);

        if (jsonBody is not null)
        {
            req.Content = new StringContent(jsonBody, Encoding.UTF8, "application/json");
        }

        _log.LogDebug("{Method} {Url}", method.Method, url);
        using var resp = await _http.SendAsync(req, HttpCompletionOption.ResponseHeadersRead, ct).ConfigureAwait(false);
        var body = await resp.Content.ReadAsStringAsync(ct).ConfigureAwait(false);

        if ((int)resp.StatusCode == 302 || (int)resp.StatusCode == 401)
        {
            throw new {{ProjectName}}AuthenticationException(
                $"{{ProjectName}} returned {(int)resp.StatusCode} (likely session expired). " +
                "Re-run the authenticator to refresh the cookie.");
        }
        if (!resp.IsSuccessStatusCode)
        {
            var preview = body.Length > 400 ? body[..400] + "..." : body;
            throw new HttpRequestException($"{{ProjectName}} {path} -> {(int)resp.StatusCode}: {preview}");
        }
        return body;
    }

    private static T Deserialize<T>(string json)
    {
        var result = JsonSerializer.Deserialize<T>(json, s_jsonOptions);
        if (result is null)
        {
            throw new InvalidOperationException("{{ProjectName}} response deserialized to null.");
        }
        return result;
    }

    private static string BuildQuery(IEnumerable<KeyValuePair<string, string?>>? query)
    {
        if (query is null) return "";
        var sb = new StringBuilder();
        bool first = true;
        foreach (var kv in query)
        {
            if (kv.Value is null) continue;
            sb.Append(first ? '?' : '&');
            sb.Append(Uri.EscapeDataString(kv.Key));
            sb.Append('=');
            sb.Append(Uri.EscapeDataString(kv.Value));
            first = false;
        }
        return sb.ToString();
    }

    public void Dispose()
    {
        if (_ownsHttpClient)
        {
            _http.Dispose();
        }
    }
}

/// <summary>
/// Thrown when {{ProjectName}} returns an auth-failure status (302/401), typically
/// because the session cookie has expired.
/// </summary>
public sealed class {{ProjectName}}AuthenticationException : InvalidOperationException
{
    public {{ProjectName}}AuthenticationException(string message) : base(message) { }
}
