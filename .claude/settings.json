{
  "env": {
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1"
  },
  "permissions": {
    "allow": [
      "Bash(dotnet --version *)",
      "PowerShell(dotnet --version *)",
      "Bash(dotnet build *)",
      "PowerShell(dotnet build *)",
