      "PowerShell(dotnet format *)",
      "Bash(dotnet run *)",
      "PowerShell(dotnet run *)",
      "Bash(dotnet test *)",
      "PowerShell(dotnet test *)",
      "Bash(gh *)",
      "PowerShell(gh *)",
      "Bash(git *)",
      "PowerShell(git *)",
      "PowerShell(Add-Type *)",
